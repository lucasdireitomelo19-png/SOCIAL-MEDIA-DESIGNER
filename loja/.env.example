# Banco de dados Postgres. Localmente, use um Postgres na sua máquina (ou Docker).
# Em produção: Netlify DB (Neon), Railway Postgres, Supabase, etc — qualquer Postgres serve.
# (Se usar o Netlify DB via dashboard, ele injeta NETLIFY_DATABASE_URL automaticamente,
# e o app já sabe usar essa variável como alternativa a DATABASE_URL.)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/loja"

# Segredo usado para assinar a sessão do admin. Gere um novo com: openssl rand -base64 32
SESSION_SECRET=""

# Onde as fotos enviadas pelo admin ficam salvas quando NÃO está rodando no Netlify
# (local, Railway, Docker, etc). No Netlify, isso é ignorado — as fotos vão para o
# Netlify Blobs automaticamente. Em outro host com disco persistente (ex: volume do
# Railway), aponte para um caminho absoluto dentro dele, ex: /data/uploads
UPLOAD_DIR=""

# Credenciais do admin criado pelo seed (opcional, tem padrão — troque depois do primeiro login)
SEED_ADMIN_EMAIL="admin@renovebrecho.com.br"
SEED_ADMIN_PASSWORD="TrocarSenha123!"

# Mercado Pago — crie uma aplicação em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# URL pública do site (usada nas URLs de retorno do checkout e no webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
