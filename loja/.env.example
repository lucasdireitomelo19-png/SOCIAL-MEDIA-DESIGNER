# Banco de dados (SQLite local para desenvolvimento).
# Para produção, troque por uma URL de banco hospedado (ex: Turso) mantendo o mesmo formato libsql.
DATABASE_URL="file:./dev.db"
# Necessário apenas se DATABASE_URL apontar para um banco remoto (ex: Turso)
DATABASE_AUTH_TOKEN=""

# Segredo usado para assinar a sessão do admin. Gere um novo com: openssl rand -base64 32
SESSION_SECRET=""

# Credenciais do admin criado pelo seed (opcional, tem padrão — troque depois do primeiro login)
SEED_ADMIN_EMAIL="admin@renovebrecho.com.br"
SEED_ADMIN_PASSWORD="TrocarSenha123!"

# Mercado Pago — crie uma aplicação em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=""
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# URL pública do site (usada nas URLs de retorno do checkout e no webhook do Mercado Pago)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
